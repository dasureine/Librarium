# Librarium 制书后端环境配置示例
# 复制本文件为 .env 并填入真实密钥后即可使用（.env 已被 .gitignore 忽略，不会提交）。

# OpenAI 兼容接口地址（默认 DeepSeek）
API_BASE_URL=https://api.deepseek.com

# 你的 API 密钥（必填，替换为真实值）
API_KEY=your_api_key_here

# 深度模型（用于逐章精读、总览与整书知识图谱综合）
MODEL_PRO=deepseek-v4-pro

# 轻量快速模型（用于 JSON 校验修复与 books.json 元数据，非思考模式）
MODEL_FLASH=deepseek-flash

# 是否启用深度思考（true / false）
ENABLE_THINKING=true
